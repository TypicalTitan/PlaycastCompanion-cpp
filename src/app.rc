#include <windows.h>

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PC_VERSION_MAJOR,PC_VERSION_MINOR,PC_VERSION_PATCH,0
 PRODUCTVERSION PC_VERSION_MAJOR,PC_VERSION_MINOR,PC_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TypicalTitan"
            VALUE "FileDescription", "Playcast Companion"
            VALUE "FileVersion", PC_FILE_VERSION_STRING
            VALUE "InternalName", "PlaycastCompanion"
            VALUE "LegalCopyright", "MIT License - github.com/TypicalTitan/PlaycastCompanion-cpp"
            VALUE "OriginalFilename", "PlaycastCompanion.exe"
            VALUE "ProductName", "Playcast Companion"
            VALUE "ProductVersion", PC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
