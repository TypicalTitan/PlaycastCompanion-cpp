#include <windows.h>

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,2,1,0
 PRODUCTVERSION 3,2,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TypicalTitan"
            VALUE "FileDescription", "Playcast Companion"
            VALUE "FileVersion", "3.2.1.0"
            VALUE "InternalName", "PlaycastCompanion"
            VALUE "LegalCopyright", "MIT License - github.com/TypicalTitan/PlaycastCompanion-cpp"
            VALUE "OriginalFilename", "PlaycastCompanion.exe"
            VALUE "ProductName", "Playcast Companion"
            VALUE "ProductVersion", "3.2.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
